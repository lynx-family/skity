{
  "schema_version": 1,
  "id": "font.glyph_image.fontconfig.source_sans_regular",
  "category": "glyph_image",
  "status": "active",
  "backend": "fontconfig",
  "platforms": [
    "linux-fontconfig"
  ],
  "font_request": {
    "size": 64,
    "scale_x": 1,
    "skew_x": 0,
    "linear_metrics": false,
    "subpixel": true,
    "embolden": false,
    "hinting": "none"
  },
  "image_request": {
    "context_scale": 1,
    "transform": {
      "scale_x": 1,
      "skew_x": 0,
      "skew_y": 0,
      "scale_y": 1
    }
  },
  "glyphs": {
    "chars": [
      "U+0041"
    ]
  },
  "compare": {
    "glyph_image": {
      "mode": "exact"
    }
  },
  "font_manager_request": {
    "entry": "MatchFamilyStyle",
    "family_name": "Source Sans Pro",
    "style": {
      "weight": 400,
      "width": 5,
      "slant": "upright"
    }
  }
}
